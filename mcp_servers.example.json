{
    "mcp_servers": {
      "openclaw": {
        "command": "npx",
        "args": ["openclaw-mcp"],
        "env": {
          "OPENCLAW_URL": "http://192.168.xx.xx:18789",
          "OPENCLAW_GATEWAY_TOKEN": ""
        }
      },
      "time": {
        "command": "uvx",
        "args": ["mcp-server-time", "--local-timezone=Asia/Shanghai"]
      },
      "ddg-search": {
        "command": "uvx",
        "args": ["duckduckgo-mcp-server"]
      }
    }
}
