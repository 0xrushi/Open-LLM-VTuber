[Unit]
Description=Open LLM VTuber launcher (with nullclaw gateway)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/alpha/Documents/Open-LLM-VTuber
EnvironmentFile=-/home/alpha/.config/open-llm-vtuber.env
PassEnvironment=GEMINI_API_KEY LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY
Environment=OPEN_LLM_VTUBER_DIR=/home/alpha/Documents/Open-LLM-VTuber
Environment=NULLCLAW_BIN=/home/alpha/Documents/nullclaw/zig-out/bin/nullclaw
Environment=NULLCLAW_HOST=0.0.0.0
Environment=NULLCLAW_PORT=5001
ExecStart=/home/alpha/Documents/Open-LLM-VTuber/scripts/run_with_nullclaw_gateway.sh
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=default.target
